node_modules/
dist/
# @ewa/content commits its built heightfields (spine §3.10 rule 12); everything else under its dist/ stays ignored.
!packages/content/dist/
packages/content/dist/*
!packages/content/dist/heightfields/
dist-types/
build/
out/
*.tsbuildinfo
.vite/
coverage/
.eslintcache
*.log
.env
.env.local
# SPEC §50.5 / §50.2.3: the audit shots and the budget JSON (+ dumps) are committed; every other capture stays local.
.screenshots/*
!.screenshots/audit/
!.screenshots/budget/
.probe/
.DS_Store
Thumbs.db

# Raw art sources (398 MB of creature illustrations + GLBs). Not tracked; see assets-src/README.md.
assets-src/creatures/
assets-src/models/
# gpt-image raw 1024 px images, refs and the spend log (.design/imagegen/pixel-tools)
assets-src/imagegen/
# CC0 audio packs (Phase E4): downloaded on approval, re-fetchable from the URLs in .design/audio/sources.json
assets-src/audio/cc0/
# Pipeline scratch
tools/sprite-pipeline/.cache/
tools/audio-pipeline/.cache/
tools/audio-pipeline/out/
tools/material-bake/.cache/
# Design hook cache
.impeccable/
tools/model-pipeline/.cache/
tools/asset-audit/.cache/
tools/asset-audit/.audit/report.json
.cdp-shots/
# M3 shot PNGs (~350 MB) are regenerated with `pnpm --filter @ewa/client harness:shots --set M3`; only the JSON sidecars are committed
.screenshots/audit/M3/**/*.png
# Local LLM weights for NPC talk (docker-compose.yml mounts models/gemma4-e2b); only the folder's .gitkeep is tracked
models/**
!models/*/
!models/*/.gitkeep

# creature-models preview renders (tools/creature-models build.mjs)
previews/
