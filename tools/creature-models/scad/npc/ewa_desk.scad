// Team Ewamon HQ's desk (mirevale.house5; rig: rigs/npc/ewa_desk.mjs, static): one 4-person desk, four office chairs
// with a black suit jacket over each back, a back-to-back monitor pair per opposite pair (each screen facing its
// sitter), keyboards, mice, energy drinks, a pizza box and Yasser's coins. 1 unit = 1 cm, origin = the desk's centre on
// the floor, long axis along X. Footprint: the desk top 200 x 130 (x -100..100, y -65..65), top at z = 72; with the
// chairs pulled up about 200 x 262 (y -131..131).
//
// Seats: where each person's model origin (their feet, rigs/npc/_seated.mjs) goes, (x, y) in cm, and which way the
// person faces in this frame (the person models face -Y at rest):
//   ewa_red1     (-50, -56)  faces +Y (the model turned 180 degrees about Z)
//   ewa_yasin    ( 50, -56)  faces +Y (turned 180)
//   ewa_mohaned  (-50,  56)  faces -Y (as built)
//   ewa_yasser   ( 50,  56)  faces -Y (as built)
// Red1 sits opposite Mohaned, Yasin opposite Yasser; Red1 and Yasin share the -Y side.
//
// Each seat's things are authored in that person's own frame (`at_seat`, the _seated.mjs contract): the seat top at
// z = 46 centred 36 behind the feet, the desk edge at y = 9, the keyboard at (0, -6), the mouse at (-27, -6), the
// monitor's screen at y = -50. The screens glow and carry each member's story in Red1's original 2022 pixel art
// (_ewa_screens.scad, generated by gen-ewa-screens.mjs): Red1 a pixel editor with Kygra (Raidori in the preview),
// Mohaned database tables, Yasser the shop (Resilian, Moflame, Darkone with coin-yellow prices), Yasin a battle
// (Moflame vs Darkone, two HP bars).
include <../lib.scad>
include <_ewa_screens.scad>

$fa = 12;
$fs = 1.5;

TOP_Z = 72;
TOP_T = 3;
HX = 100;
HY = 65;
SEATS = [["ewa_red1", -50, -56, 180], ["ewa_yasin", 50, -56, 180], ["ewa_mohaned", -50, 56, 0], ["ewa_yasser", 50, 56, 0]];

WOOD = [0.86, 0.8, 0.7, NOGLOW];
WOOD_EDGE = [0.3, 0.3, 0.32, NOGLOW];
STEEL = [0.2, 0.2, 0.22, NOGLOW];
CHAIR = [0.3, 0.33, 0.38, NOGLOW];
CHAIR_MESH = [0.4, 0.44, 0.5, NOGLOW];
JACKET = [0.05, 0.05, 0.065, NOGLOW];
LINING = [0.42, 0.07, 0.1, NOGLOW];
BEZEL = [0.08, 0.08, 0.09, NOGLOW];
PLASTIC = [0.16, 0.16, 0.18, NOGLOW];
KEYCAP = [0.3, 0.3, 0.33, NOGLOW];
GOLD = [0.99, 0.8, 0.15];      // the shop's coin yellow (a screen colour: px() makes it glow)

module box(c, lo, hi) color(c) translate(lo) cube(hi - lo);
module at_seat(s) translate([s[1], s[2], 0]) rotate([0, 0, s[3]]) children();

// ---- the desk -----------------------------------------------------------------------------------------------------

module desk() {
  box(WOOD, [-HX, -HY, TOP_Z - TOP_T], [HX, HY, TOP_Z]);
  // a dark edge band round the top
  for (m = [-1, 1]) {
    box(WOOD_EDGE, [-HX - 0.4, m * HY - 0.4, TOP_Z - TOP_T + 0.4], [HX + 0.4, m * HY + 0.4, TOP_Z - 0.4]);
    box(WOOD_EDGE, [m * HX - 0.4, -HY - 0.4, TOP_Z - TOP_T + 0.4], [m * HX + 0.4, HY + 0.4, TOP_Z - 0.4]);
  }
  // two steel frame legs at the ends (clear of every knee) and a beam down the middle under the monitors
  for (m = [-1, 1]) {
    box(STEEL, [m * 92 - 3, -HY + 6, 0], [m * 92 + 3, -HY + 12, TOP_Z - TOP_T]);
    box(STEEL, [m * 92 - 3, HY - 12, 0], [m * 92 + 3, HY - 6, TOP_Z - TOP_T]);
    box(STEEL, [m * 92 - 3, -HY + 4, 0], [m * 92 + 3, HY - 4, 3]);
    box(STEEL, [m * 92 - 2.5, -HY + 6, TOP_Z - TOP_T - 5], [m * 92 + 2.5, HY - 6, TOP_Z - TOP_T]);
  }
  box(STEEL, [-92, -4, TOP_Z - TOP_T - 6], [92, 4, TOP_Z - TOP_T]);
}

// ---- a chair (person frame: faces -Y, seat centre (0, 36)) and the jacket over its back ---------------------------

module chair() {
  sy = 36;
  // seat cushion
  color(CHAIR) hull() for (x = [-21, 21], y = [sy - 20, sy + 20]) translate([x, y, 42]) cylinder(h = 4, r = 3, $fn = 12);
  box(STEEL, [-15, sy - 14, 37], [15, sy + 14, 42]);
  // gas lift and the five-star base on castors (no arm points at the feet)
  color(STEEL) translate([0, sy, 8]) cylinder(h = 30, r = 2.6, $fn = 14);
  for (a = [0 : 72 : 288]) let(d = [sin(a), cos(a)]) {
    color(STEEL) hull() {
      translate([0, sy, 6]) sphere(3, $fn = 10);
      translate([28 * d[0], sy + 28 * d[1], 6]) sphere(1.8, $fn = 8);
    }
    color(PLASTIC) translate([28 * d[0], sy + 28 * d[1], 2.6]) sphere(2.6, $fn = 10);
  }
  // back: two uprights from under the seat and a mesh backrest, leaning back a little
  for (m = [-1, 1]) color(STEEL) hull() {
    translate([m * 17, sy + 16, 40]) sphere(1.4, $fn = 8);
    translate([m * 19, sy + 25, 100]) sphere(1.4, $fn = 8);
  }
  color(CHAIR) hull() for (x = [-19, 19], z = [56, 100]) translate([x, sy + 21 + (z - 56) * 0.1, z]) rotate([90, 0, 0]) cylinder(h = 3, r = 2.5, center = true, $fn = 10);
  color(CHAIR_MESH) hull() for (x = [-16, 16], z = [59, 97]) translate([x, sy + 19.6 + (z - 56) * 0.1, z]) rotate([90, 0, 0]) cylinder(h = 0.6, r = 2, center = true, $fn = 10);
}

// the jacket hung by its shoulders over the backrest: the body down the back, the sleeves down the sides, the lining
// showing at the open front edges
module jacket(tilt = 0) {
  sy = 36 + 21 + 4.4;          // the backrest's back face near the top
  translate([0, 0, 0]) rotate([0, 0, tilt]) {
    color(JACKET) hull() {
      for (m = [-1, 1]) translate([m * 19, sy - 1.5, 101.5]) scale([4.4, 4.6, 2.6]) sphere(1, $fn = 12);
      translate([0, sy + 0.5, 102.6]) scale([12, 3.6, 2.2]) sphere(1, $fn = 14);
      for (m = [-1, 1]) translate([m * 20.5, sy + 2.6, 60]) scale([3.5, 2, 3]) sphere(1, $fn = 10);
      translate([0, sy + 3.8, 62]) scale([16, 2.2, 4]) sphere(1, $fn = 12);
    }
    // the collar standing on top of the backrest
    color(JACKET) hull() for (m = [-1, 1]) translate([m * 7, sy - 0.5, 104.4]) scale([2.4, 3.2, 1.8]) sphere(1, $fn = 10);
    // sleeves hanging down the sides of the backrest
    for (m = [-1, 1]) color(JACKET) hull() {
      translate([m * 22.5, sy - 2, 99]) sphere(3.6, $fn = 10);
      translate([m * 23.8, sy - 4.5, 64]) sphere(3.0, $fn = 10);
    }
    // the lining at the hem, a back vent
    color(LINING) translate([0, sy + 4.9, 60.8]) scale([13, 1, 2.2]) sphere(1, $fn = 12);
    box([0.02, 0.02, 0.025, NOGLOW], [-0.3, sy + 5.2, 62], [0.3, sy + 5.8, 78]);
  }
}

// ---- the desk things at a seat (person frame) -----------------------------------------------------------------

module keyboard() {
  box(PLASTIC, [-22, -12.5, TOP_Z], [22, 0.5, TOP_Z + 1.4]);
  for (r = [0 : 4]) color(KEYCAP) for (k = [0 : (r == 4 ? 2 : 3)]) let(w = r == 4 ? 12.4 : 9.4, x0 = r == 4 ? -19 : -20.6)
    translate([x0 + k * (w + 1.2), -11.6 + r * 2.4, TOP_Z + 1.4]) cube([w, 1.9, 0.9]);
}
module mouse() {
  box([0.12, 0.12, 0.14, NOGLOW], [-37, -16, TOP_Z], [-17, 3, TOP_Z + 0.3]);
  color(PLASTIC) translate([-27, -6, TOP_Z + 0.3]) scale([3.1, 5.2, 2.0]) sphere(1, $fn = 14);
  color([0.85, 0.15, 0.2, NOGLOW]) translate([-27, -9.4, TOP_Z + 1.7]) scale([0.4, 1.1, 0.5]) sphere(1, $fn = 8);
}
module can(c, band) {
  color([0.75, 0.76, 0.78, NOGLOW]) cylinder(h = 0.6, r = 3.0, $fn = 16);
  color(c) translate([0, 0, 0.6]) cylinder(h = 11, r = 3.3, $fn = 16);
  color(band) translate([0, 0, 4.2]) cylinder(h = 3.6, r = 3.35, $fn = 16);
  color([0.75, 0.76, 0.78, NOGLOW]) translate([0, 0, 11.6]) cylinder(h = 0.8, r1 = 3.3, r2 = 2.7, $fn = 16);
}
module coins(n) for (i = [0 : n - 1]) color([0.98, 0.76, 0.18, NOGLOW]) translate([0.2 * sin(i * 77), 0.2 * cos(i * 77), TOP_Z + i * 0.32]) cylinder(h = 0.3, r = 1.4, $fn = 14);

// ---- the monitor (person frame: the screen's face at y = -50, facing the sitter) ----------------------------------

SW = 52;      // screen size
SH = 30;
SCR_Z = 108;  // screen centre height
SCR_Y = -50;

module monitor() {
  // the panel and its bezel behind the screen face
  box(BEZEL, [-SW / 2 - 1.2, SCR_Y - 2.6, SCR_Z - SH / 2 - 1.2], [SW / 2 + 1.2, SCR_Y, SCR_Z + SH / 2 + 1.2]);
  box(BEZEL, [-SW / 2 - 1.2, SCR_Y - 0.01, SCR_Z - SH / 2 - 2.6], [SW / 2 + 1.2, SCR_Y + 0.6, SCR_Z - SH / 2 - 1.2]);
  // the stand: a neck in this monitor's half of the desk and a foot plate
  box(STEEL, [-3, SCR_Y - 5.4, TOP_Z], [3, SCR_Y - 2.6, SCR_Z - 6]);
  box(STEEL, [-11, SCR_Y - 5.8, TOP_Z], [11, SCR_Y + 6, TOP_Z + 0.8]);
}

// The screen's content frame: u to the sitter's right, v up, both from the screen's centre, d towards the sitter
// (layers of 0.15 cm on the glass).
module screen() translate([0, SCR_Y, SCR_Z]) rotate([90, 0, 180]) children();
L = 0.15;
module px(c, u0, v0, u1, v1, layer = 0) color([c[0], c[1], c[2], GLOW]) translate([u0, v0, layer * L]) cube([u1 - u0, v1 - v0, L + 0.01]);
module dot(c, u, v, r, layer = 1) color([c[0], c[1], c[2], GLOW]) translate([u, v, layer * L]) cylinder(h = L + 0.01, r = r, $fn = 12);

// a table of the ER diagram: a coloured header, striped rows (name, type), the key row marked in gold
module db_table(u, v, w, rows, head) {
  px(head, u, v, u + w, v + 2.2, 1);
  px([0.95, 0.95, 0.95], u + 0.6, v + 0.8, u + w * 0.55, v + 1.4, 2);
  for (r = [0 : rows - 1]) let(y = v - (r + 1) * 1.9) {
    px(r % 2 == 0 ? [0.84, 0.87, 0.92] : [0.74, 0.78, 0.85], u, y, u + w, y + 1.9, 1);
    px([0.3, 0.34, 0.42], u + 1.8, y + 0.7, u + 1.8 + w * (0.3 + 0.15 * ((r * 7 + w) % 3)), y + 1.2, 2);
    px([0.45, 0.55, 0.75], u + w * 0.66, y + 0.7, u + w - 0.8, y + 1.2, 2);
    if (r == 0) dot([0.98, 0.78, 0.15], u + 0.9, y + 0.95, 0.5, 2);
  }
}

// a shop card: the Ewamon on a tinted panel, its name, a gold price tag with a coin, a buy button
module shop_card(u, bg, sz) {
  px([0.99, 0.99, 0.97], u, -14, u + 15, 8.2, 1);
  px(bg, u + 0.8, -3.4, u + 14.2, 7.4, 2);
  translate([u + 7.5 - sz[0] / 2, -3 + (10.4 - sz[1]) / 2, 3 * L]) scale([0.3, 0.3, L]) children();
  px([0.25, 0.25, 0.3], u + 1.2, -5.4, u + 10, -4.4, 2);
  // the price tag: a gold pill with a coin and the digits
  px(GOLD, u + 1.2, -9.4, u + 9.6, -6.6, 2);
  dot([0.85, 0.6, 0.05], u + 2.6, -8, 0.9, 3);
  for (k = [0 : 2]) px([0.45, 0.3, 0.05], u + 4.2 + k * 1.6, -8.6, u + 5.3 + k * 1.6, -7.4, 3);
  // buy button
  px([0.5, 0.2, 0.7], u + 1.2, -13, u + 13.8, -10.4, 2);
  px([0.98, 0.98, 0.98], u + 5, -12, u + 10, -11.4, 3);
}

// a battle HP box: name and bar (fill 0..1)
module battle_hp(u, v, fill, c) {
  px([0.97, 0.96, 0.9], u, v, u + 18, v + 4.6, 2);
  px([0.25, 0.25, 0.28], u + 1, v + 2.8, u + 9, v + 3.8, 3);
  px([0.3, 0.3, 0.32], u + 1, v + 0.8, u + 17, v + 2, 3);
  px(c, u + 1.2, v + 1, u + 1.2 + 15.6 * fill, v + 1.8, 4);
}

// Red1: a pixel editor, Kygra on the checker canvas under a pixel grid, Raidori in the preview, the palette
module screen_red1() screen() {
  P = 0.66;
  px([0.16, 0.16, 0.19], -SW / 2, -SH / 2, SW / 2, SH / 2);
  px([0.27, 0.27, 0.31], -SW / 2, 13.4, SW / 2, SH / 2, 1);
  for (i = [0 : 4]) px([0.55, 0.55, 0.6], -25 + i * 5, 14, -21.6 + i * 5, 14.5, 2);
  // tools
  px([0.22, 0.22, 0.26], -SW / 2, -SH / 2, -22.6, 13.4, 1);
  for (i = [0 : 5]) px(i == 1 ? [0.35, 0.6, 0.98] : [0.62, 0.62, 0.66], -25.2, 10.2 - i * 3.3, -23.4, 12 - i * 3.3, 2);
  // canvas: checker, sprite, grid every 4 pixels
  cu = -21.6; cv = -14.2; cw = 30.4; ch = 26.6;
  for (i = [0 : 12], j = [0 : 11]) if ((i + j) % 2 == 0) px([0.82, 0.82, 0.86], cu + i * cw / 13, cv + j * ch / 12, cu + (i + 1) * cw / 13, cv + (j + 1) * ch / 12, 1);
  px([0.68, 0.68, 0.73], cu, cv, cu + cw, cv + ch, 0.5);
  translate([cu + (cw - EWA_KYGRA[0] * P) / 2, cv + (ch - EWA_KYGRA[1] * P) / 2, 2 * L]) scale([P, P, L]) ewa_kygra();
  for (i = [0 : 7]) px([0.3, 0.3, 0.36], cu + i * 4 * P + 0.4, cv, cu + i * 4 * P + 0.48, cv + ch, 3);
  for (j = [0 : 6]) px([0.3, 0.3, 0.36], cu, cv + j * 4 * P + 0.3, cu + cw, cv + j * 4 * P + 0.38, 3);
  // preview with Raidori, palette swatches
  px([0.22, 0.22, 0.26], 9.4, -SH / 2, SW / 2, 13.4, 1);
  px([0.1, 0.1, 0.13], 10.4, 0.4, 25.2, 12.6, 2);
  translate([10.4 + (14.8 - EWA_RAIDORI[0] * 0.52) / 2, 0.8, 3 * L]) scale([0.52, 0.52, L]) ewa_raidori();
  SW_C = [[0.1, 0.22, 0.55], [0.2, 0.42, 0.85], [0.45, 0.7, 0.98], [0.95, 0.8, 0.2], [0.98, 0.98, 0.98], [0.1, 0.1, 0.12],
          [0.55, 0.5, 0.75], [0.3, 0.28, 0.45], [0.92, 0.3, 0.25], [0.98, 0.6, 0.2], [0.4, 0.75, 0.4], [0.7, 0.45, 0.25]];
  for (i = [0 : 11]) px(SW_C[i], 10.6 + (i % 4) * 3.7, -2.6 - floor(i / 4) * 3.7, 13.6 + (i % 4) * 3.7, 0.4 - floor(i / 4) * 3.7 - 0.6, 2);
  px([0.95, 0.95, 0.95], 13.95, -2.95, 17.65, 0.15, 1.5);
}

// Mohaned: database tables (an ER diagram), keys in gold, relations between them, a query strip at the bottom
module screen_mohaned() screen() {
  px([0.09, 0.11, 0.15], -SW / 2, -SH / 2, SW / 2, SH / 2);
  px([0.16, 0.19, 0.25], -SW / 2, 13.4, SW / 2, SH / 2, 1);
  for (i = [0 : 3]) px([0.5, 0.6, 0.75], -25 + i * 6, 14, -20.4 + i * 6, 14.5, 2);
  db_table(-24.5, 9.8, 13.4, 5, [0.25, 0.5, 0.95]);
  db_table(-6.4, 11.6, 13.4, 4, [0.95, 0.55, 0.15]);
  db_table(11.2, 9.2, 13.6, 6, [0.6, 0.35, 0.85]);
  db_table(-6.4, -0.4, 13.4, 3, [0.2, 0.7, 0.6]);
  // relations
  C = [0.65, 0.75, 0.9];
  px(C, -11.1, 5.3, -6.4, 5.6, 1);
  px(C, 7, 7.3, 11.2, 7.6, 1);
  px(C, 0.3, 4.0, 0.6, 1.8, 1);
  px(C, 7, -3.0, 9.6, -2.7, 1);
  px(C, 9.3, -3.0, 9.6, 1.8, 1);
  px(C, 9.3, 1.5, 11.2, 1.8, 1);
  // the query strip
  px([0.05, 0.06, 0.08], -SW / 2, -SH / 2, SW / 2, -9.6, 1);
  QC = [[0.85, 0.45, 0.9], [0.95, 0.95, 0.95], [0.4, 0.85, 0.95], [0.95, 0.75, 0.3]];
  for (r = [0 : 2]) for (k = [0 : 3]) let(u = -24.5 + k * 9.5 + r * 1.3)
    px(QC[(k + r) % 4], u, -11.2 - r * 1.4, u + 4 + 2 * ((k + r) % 2), -10.6 - r * 1.4, 2);
  px([0.95, 0.3, 0.3], -24.5, -14.6, -10, -14.0, 2);
}

// Yasser: the shop, three Ewamon cards with coin-yellow price tags, Yaschamp in the header
module screen_yasser() screen() {
  px([0.95, 0.92, 0.84], -SW / 2, -SH / 2, SW / 2, SH / 2);
  px([0.5, 0.2, 0.7], -SW / 2, 10, SW / 2, SH / 2, 1);
  translate([-24.6, 10.3, 2 * L]) scale([0.14, 0.14, L]) ewa_yaschamp();
  px([0.98, 0.98, 0.98], -20.6, 12.2, -8, 13.4, 2);
  // the wallet: a coin and its count
  dot(GOLD, 17.6, 12.5, 1.3, 2);
  px([0.98, 0.98, 0.98], 19.6, 12, 24.6, 13, 2);
  shop_card(-24.5, [0.82, 0.95, 0.8], EWA_RESILIAN * 0.3) ewa_resilian();
  shop_card(-7.5, [1, 0.88, 0.78], EWA_MOFLAME * 0.3) ewa_moflame();
  shop_card(9.5, [0.86, 0.84, 0.96], EWA_DARKONE * 0.3) ewa_darkone();
}

// Yasin: a battle, Moflame (his side, bottom left, facing right) vs Darkone (top right), two HP bars, the text box
module screen_yasin() screen() {
  px([0.55, 0.8, 0.98], -SW / 2, -1, SW / 2, SH / 2);
  px([0.48, 0.76, 0.38], -SW / 2, -SH / 2, SW / 2, -1);
  // platforms
  dot([0.36, 0.62, 0.3], 13.5, -1, 7.5, 1);
  dot([0.36, 0.62, 0.3], -14, -8.6, 9, 1);
  translate([7.5, -1.6, 2 * L]) scale([0.36, 0.36, L]) ewa_darkone();
  translate([-23 + EWA_MOFLAME[0] * 0.42, -8.4, 2 * L]) mirror([1, 0, 0]) scale([0.42, 0.42, L]) ewa_moflame();
  battle_hp(-24.5, 9.4, 0.72, [0.25, 0.85, 0.35]);
  battle_hp(5.5, -7.6, 0.34, [0.98, 0.78, 0.15]);
  // text box
  px([0.15, 0.2, 0.45], -SW / 2, -SH / 2, SW / 2, -9.2, 3);
  px([0.97, 0.97, 0.97], -25.2, -14.3, 25.2, -9.9, 4);
  for (r = [0 : 1]) px([0.2, 0.2, 0.25], -23.8, -11.6 - r * 1.8, r == 0 ? 6 : -4, -11 - r * 1.8, 5);
}

// ---- the set ----------------------------------------------------------------------------------------------------

desk();
for (s = SEATS) at_seat(s) {
  chair();
  jacket(s[0] == "ewa_yasin" ? 3 : s[0] == "ewa_mohaned" ? -2 : 0);
  keyboard();
  mouse();
  monitor();
  if (s[0] == "ewa_red1") screen_red1();
  if (s[0] == "ewa_mohaned") screen_mohaned();
  if (s[0] == "ewa_yasser") screen_yasser();
  if (s[0] == "ewa_yasin") screen_yasin();
}
// energy drinks: Red1's on his left, one by Yasin's mouse, Mohaned's on his left
at_seat(SEATS[0]) translate([31, -14, TOP_Z]) can([0.08, 0.08, 0.09, NOGLOW], [0.55, 0.95, 0.15, NOGLOW]);
at_seat(SEATS[1]) translate([-43, -16, TOP_Z]) can([0.15, 0.35, 0.85, NOGLOW], [0.8, 0.82, 0.86, NOGLOW]);
at_seat(SEATS[2]) translate([32, -20, TOP_Z]) can([0.08, 0.08, 0.09, NOGLOW], [0.55, 0.95, 0.15, NOGLOW]);
// Yasser's coins, left of his keyboard (rigs/npc/ewa_yasser.mjs idle_coins: FROM (31, -4) and TO (31, -18))
at_seat(SEATS[3]) { translate([31, -4, 0]) coins(7); translate([31, -18, 0]) coins(2); translate([34.5, -11, 0]) coins(1); }
// the pizza box, open, between the monitor pairs: two slices gone
translate([0, -20, TOP_Z]) rotate([0, 0, 6]) {
  box([0.86, 0.76, 0.6, NOGLOW], [-18, -18, 0], [18, 18, 3.6]);
  box([0.92, 0.84, 0.7, NOGLOW], [-17, -17, 0.4], [17, 17, 3.7]);
  color([0.93, 0.68, 0.3, NOGLOW]) translate([0, 0, 3.7]) difference() {
    cylinder(h = 0.9, r = 15.5, $fn = 32);
    translate([0, 0, -1]) linear_extrude(3) polygon([[0, 0], [20, -2], [16, 14]]);
  }
  color([0.85, 0.28, 0.15, NOGLOW]) translate([0, 0, 4.5]) difference() {
    cylinder(h = 0.25, r = 13.6, $fn = 32);
    translate([0, 0, -1]) linear_extrude(3) polygon([[0, 0], [20, -3.4], [16, 15.5]]);
  }
  for (p = [[-7, 5], [-3, -8], [-9, -4], [3, 7], [6, -6], [-2, 1], [-6, 11], [10, -11]])
    color([0.62, 0.12, 0.1, NOGLOW]) translate([p[0], p[1], 4.7]) cylinder(h = 0.3, r = 1.6, $fn = 10);
  // the lid flipped open, lying back at a low angle
  translate([0, 18, 3.6]) rotate([-158, 0, 0]) box([0.86, 0.76, 0.6, NOGLOW], [-18, -36, 0], [18, 0, 1.2]);
}
