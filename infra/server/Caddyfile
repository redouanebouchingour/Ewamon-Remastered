# /etc/caddy/Caddyfile — the one public entry. Caddy fetches and renews the TLS certificates itself.

(ewamon) {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle_path /colyseus/* {
		reverse_proxy 127.0.0.1:2567
	}
	handle_path /npc/llm/* {
		reverse_proxy 127.0.0.1:8081 {
			flush_interval -1
		}
	}
	handle /_deploy/* {
		reverse_proxy 127.0.0.1:9000
	}
	handle {
		root * /srv/ewamon/www
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

ewamon.com {
	import ewamon
}

www.ewamon.com {
	redir https://ewamon.com{uri} permanent
}
