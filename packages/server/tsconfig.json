{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022"],
    "types": ["node"],
    // Same pair as packages/protocol/tsconfig.json: @colyseus/schema 5 uses legacy PropertyDecorators and
    // needs [[Set]] class-field semantics (see packages/protocol/IMPLEMENTATION-NOTES.md).
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../core" }, { "path": "../content" }, { "path": "../protocol" }, { "path": "../persist" }]
}
